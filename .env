SITE_NAME_HEADER=情栀凉橙🍊的小破站
SITE_MAIN_LANGUAGE=cn
SITE_BASE_URL=https://qingzhiliangcheng.netlify.app/
SHOW_CREATED_TIMESTAMP=true
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=true
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=true
NOTE_ICON_FILETREE=true
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --color-highlight-rgb: var(--highlight-orange-rgb); --file-line-width-multiplier: 43.75; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager ss-section-news white velocity-gray enable-special-text enable-special-code active-line-highlight mk-readable-line mk-folder-lines mk-spaces-enabled mk-inline-context-enabled mk-mobile-styler mk-flow-replace mk-flow-minimal image-alignment-default-center AT-row
USE_FULL_RESOLUTION_IMAGES=false
THEME=https://raw.githubusercontent.com/gonzalo-d-sales/obsidian-velocity/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgPassFrontmatter=true
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowInlineTitle=true
dgShowFileTree=false
dgEnableSearch=false
dgShowToc=true
dgLinkPreview=false
dgShowTags=true